#
# wm independent hotkeys
#

# terminal emulator ----------------
super + t
	kitty

super + Return
	kitty --hold fastfetch

# program launcher -------------------
super + Tab
	rofi -show drun

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

#
# bspwm hotkeys
#

# quit/restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close and kill
super + {_,shift + }q
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# send the newest marked node to the newest preselected node
super + y
	bspc node newest.marked.local -n newest.!automatic.local

#
# state/flags
#



# default: tiled | toggle to modes ------------------------------------
super + f
    bspc query -N -n focused.fullscreen > /dev/null && bspc node -t tiled || bspc node -t fullscreen

super + d
    bspc query -N -n focused.floating > /dev/null && bspc node -t tiled || bspc node -t floating

super + g
	bspc query -N -n focused.pseudo_tiled > /dev/null && bspc node -t tiled || bspc node -t pseudo_tiled



#
# focus/swap
#

# focus on window or swap location ---------------------------------------------
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# workspace shifter ----------------------------------------------------
super + ctrl + {Left,Right}
	~/.local/bin/bspc-switch-anim {prev,next}

# focus the last node/desktop
super + {1-9,0}
	~/.local/bin/bspc-switch-anim switch '^{1-9,10}'

super + shift + {1-9,0}
	~/.local/bin/bspc-switch-anim send '^{1-9,10}'

super + ctrl + shift + alt + {Left,Right}
	~/.local/bin/bspc-switch-anim send {prev,next}


super + ctrl + shift + {Left,Right}
	~/.local/bin/bspc-switch-anim send-follow {prev,next}.local

super + shift + alt {1-9,0}
	~/.local/bin/bspc-switch-anim send-follow '^{1-9,10}'



# firefox
super + w
	firefox

# filemanager
super + e
	thunar

# code
super + c
	code

# discord
super + k
	discord

# media
XF86AudioPlay
    playerctl play-pause

XF86AudioNext
    playerctl next

XF86AudioPrev
    playerctl previous

XF86AudioStop
    playerctl stop


# audio
XF86AudioRaiseVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

# mute key (usually comes with vol keys)
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle


#screen snip
super + shift + s
	maim -s -u | xclip -selection clipboard -t image/png
